# --- Banco (Postgres em Docker) ---
POSTGRES_DB=evprices
POSTGRES_USER=evprices
POSTGRES_PASSWORD=troque-esta-senha

# --- App ---
APP_PORT=8080
TZ=America/Sao_Paulo

# --- Filtro do que entra no banco ---
MIN_POWER_KW=22          # só tomadas com potência > este valor (estrito: AC 22 kW fica de fora)
PAID_ONLY=true           # descarta recarga sabidamente gratuita; preço desconhecido (On-Charge) continua
IBGE_MESH_QUALITY=intermediaria   # malha dos municípios: minima | intermediaria | maxima

# --- Preço de casa (referência no gráfico): tarifa ANEEL da distribuidora do município + bandeira + impostos ---
# ICMS é resolvido pela UF do município (tabela de alíquotas modais em evprices/home_tariff.py).
# Para corrigir um estado: HOME_ICMS_UF=MG=18,RJ=22
HOME_ICMS_UF=
# PIS/COFINS: cada distribuidora publica o seu todo mês; não há fonte central. Aproximação nacional + ajuste por UF.
HOME_PISCOFINS_PCT=5
HOME_PISCOFINS_UF=
HOME_REFRESH_HOURS=168   # de quanto em quanto tempo rebaixar tarifas/bandeiras da ANEEL

# --- Coleta ---
COLLECT_INTERVAL_HOURS=24   # recoleta de cada município monitorado
COLLECT_POLL_S=10           # frequência com que o collector olha por pedidos da UI
REQUEST_DELAY_S=1.0
HTTP_TIMEOUT_S=20
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) evprices-pessoal/0.1

# --- Notificações (todas opcionais) ---
# Webhook JSON genérico: Home Assistant -> Configurações > Automações > gatilho "Webhook"
# NOTIFY_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/evprices
NOTIFY_WEBHOOK_URL=
# NTFY_URL=https://ntfy.sh/meu-topico-secreto
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_NEW=false      # avisar também quando uma tomada aparece pela primeira vez
NOTIFY_ON_ERROR=true     # avisar quando a coleta falhar

# --- Cenário padrão para o ranking (BYD Dolphin GS em viagem) ---
DEFAULT_KWH=30
DEFAULT_CHARGE_MIN=40
DEFAULT_IDLE_MIN=10
